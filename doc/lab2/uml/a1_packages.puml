@startuml
!include _style.iuml
title ПОСЛЕ: пакеты и зависимости (Модель отделена)
top to bottom direction

package "gui  —  Вид и обработка ввода" as gui #EEF3FB {
  class DrawGUI
  class DrawingPanel
  class ShapePainter
  class MouseListener
  class MenuListener
  class ToolBox
}
package "controller" as controller #EAF7EA {
  class DrawingController
  enum Tool
}
package "actions  —  команды undo/redo" as actions #F3F4F6 {
  interface DrawAction
  class UndoManager
}
package "io  —  файлы .draw" as io #F3F4F6 {
  class DrawingFile
  class ShapeWriter
}
package "model  —  МОДЕЛЬ" as model #FFF8E1 {
  class Drawing
  class Selection
  abstract class Shape
  interface ShapeVisitor
  interface DrawingListener
}

gui -down-> controller : команды\nпользователя
gui .down.> model : читает,\nподписывается
controller -down-> actions
controller -down-> io
controller -down-> model
actions -down-> model
io -down-> model

note right of model
  Модель не зависит ни от одного пакета программы
  и не использует Swing / Graphics / JOptionPane
  (из java.awt — только классы-значения Point, Color, Font).
  <b>Все стрелки направлены К модели, циклов нет.</b>
end note
@enduml
